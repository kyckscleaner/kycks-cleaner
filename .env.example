# Copiez ce fichier en ".env" et remplissez les vraies valeurs (ne jamais commit .env sur GitHub).

# Connexion à la base Postgres (Neon / Vercel Postgres). Format :
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Auth.js - générez une valeur aléatoire avec: npx auth secret
AUTH_SECRET=""

# Stripe (dashboard.stripe.com/test/apikeys en mode test, /apikeys en mode live)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# URL publique du site (http://localhost:3000 en local, https://votre-domaine en production)
NEXT_PUBLIC_BASE_URL=""

# Resend (resend.com/api-keys) - envoi du code de connexion admin par email
RESEND_API_KEY=""
