generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Service {
  id              String   @id @default(cuid())
  code            String   @unique // "interieur" | "exterieur" | "complet"
  name            String
  description     String
  priceCents      Int
  durationMinutes Int
  active          Boolean  @default(true)
  order           Int      @default(0)
  appointments    AppointmentService[]
}

model Client {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

model Appointment {
  id            String                @id @default(cuid())
  client        Client                @relation(fields: [clientId], references: [id])
  clientId      String
  services      AppointmentService[]
  date          DateTime // start datetime of the appointment
  durationMinutes Int
  address       String // client's location, since cleaning happens on-site
  city          String
  postalCode    String
  vehicleInfo   String? // make/model/plate notes
  notes         String?
  status        AppointmentStatus     @default(PENDING)
  totalCents    Int
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  payments      Payment[]
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceId     String
  priceCents    Int // price snapshot at time of booking
}

enum PaymentMethod {
  CARTE_EN_LIGNE
  ESPECES
  VIREMENT
  CHEQUE
  CARTE_SUR_PLACE
}

enum PaymentStatus {
  EN_ATTENTE
  PAYE
  REMBOURSE
  ECHOUE
}

model Payment {
  id                    String        @id @default(cuid())
  appointment           Appointment   @relation(fields: [appointmentId], references: [id])
  appointmentId         String
  amountCents           Int
  method                PaymentMethod
  status                PaymentStatus @default(EN_ATTENTE)
  stripeCheckoutId      String?
  stripePaymentIntentId String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
}

// Configurable business settings for the URSSAF / tax helper module
model BusinessSettings {
  id                        String   @id @default("singleton")
  businessName              String   @default("Kycks Cleaner")
  siret                     String?
  activityType              String   @default("prestation_service_commerciale") // used to pick default cotisation rate
  cotisationRatePercent     Float    @default(21.2) // % cotisations sociales micro-entreprise (à vérifier sur urssaf.fr)
  versementLiberatoireActif Boolean  @default(false)
  versementLiberatoireRate  Float    @default(1.7) // % impôt sur le revenu si option versement libératoire
  cfpRatePercent            Float    @default(0.3) // contribution formation professionnelle
  declarationFrequency      String   @default("mensuel") // "mensuel" | "trimestriel"
  updatedAt                 DateTime @updatedAt
}
